{
  "schemaVersion": 1,
  "id": "jjk",
  "version": "${version}",
  "name": "Jujutsu",
  "description": "Jujutsu Kaisen combat for Minecraft: Gojo, Hakari, Yuji, Yuta and Ryu, and a Survival progression where kits are earned.",
  "authors": [
    "rickdapretzelstick"
  ],
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rick.jjk.JJK"
    ],
    "client": [
      "dev.rick.jjk.client.JJKClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "jjk.mixins.json",
    "jjk.progression.mixins.json",
    {
      "config": "jjk.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "jjk.progression.client.mixins.json",
      "environment": "client"
    }
  ]
}
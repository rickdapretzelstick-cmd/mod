+        _views[(rep, k)] = _build_view(rep, k, f)
     return _views[(rep, k)]
 
 
+def _prefetch_chunk(keys):
+    torch.set_num_threads(1)
+    c = cv2.VideoCapture(tracks[(REF, 'fwd')]['video'])
+    frames = sorted({k for _, k in keys})
+    c.set(cv2.CAP_PROP_POS_FRAMES, frames[0])
+    pos, img, out = frames[0], {}, {}
+    for k in frames:
+        while pos <= k:
+            ok, f = c.read()
+            pos += 1
+        img[k] = f
+    for rep, k in keys:
+        out[(rep, k)] = _build_view(rep, k, img[k])
+    return out
+
+
+def prefetch(keys, workers=int(os.environ.get('PREFETCH_WORKERS', '4'))):
+    """Windows many view frames at once: contiguous runs of frames read in sequence (no seeking), on several processes."""
+    keys = sorted({(r, k) for r, k in keys if (r, k) not in _views and best_cam(r, k) is not None}, key=lambda x: (x[1], x[0]))
+    if not keys:
+        return
+    if workers <= 1 or len(keys) < 8:
+        _views.update(_prefetch_chunk(keys))
+        return
+    import multiprocessing as mp
+    n = -(-len(keys) // workers)
+    chunks = [keys[i:i + n] for i in range(0, len(keys), n)]
+    with mp.get_context('fork').Pool(len(chunks)) as pool:
+        for d in pool.map(_prefetch_chunk, chunks):
+            _views.update(d)
+
